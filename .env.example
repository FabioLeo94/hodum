# Variabili lette da docker-compose.yml (interpolazione ${VAR} nel file
# compose), non dal backend Node in sé: quelle sono in backend/.env.example
# e restano usate solo per l'avvio in locale senza Docker (`npm run dev`).
#
# Copia questo file in ".env" nella root del repo (stessa cartella di
# docker-compose.yml: Docker Compose lo legge automaticamente) e valorizzalo
# prima di lanciare `docker compose up -d --build`.

# Credenziali del Postgres containerizzato (servizio "db"). Nessun default
# per la password: docker-compose.yml si rifiuta di partire finché non è
# impostata.
POSTGRES_USER=hodum
POSTGRES_PASSWORD=
POSTGRES_DB=hodum

# Segreto per firmare i token di sessione (JWT), stesso ruolo di JWT_SECRET
# in backend/.env.example. Obbligatoria. Genera una stringa casuale lunga,
# es. con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Porte pubblicate sull'host. Cambiale solo se 3000/8080 sono già occupate su
# questa macchina.
BACKEND_PORT=3000
FRONTEND_PORT=8080

# Host/IP con cui i browser in LAN raggiungeranno questo server. In locale
# "localhost" va bene; per un uso reale da altri PC dell'ufficio, sostituiscilo
# con l'IP o l'hostname del server (es. http://192.168.1.50) in ENTRAMBE le
# variabili sotto, poi ricostruisci con `docker compose up -d --build`
# (VITE_API_URL è "baked" nel bundle statico del frontend a build time).
VITE_API_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:8080

# Ollama: di default il backend containerizzato cerca un'istanza Ollama in
# esecuzione sull'HOST (non in questo compose), raggiunta via
# host.docker.internal. In alternativa, avvia il servizio Ollama incluso in
# docker-compose.yml con `docker compose --profile ollama up -d` e imposta
# OLLAMA_BASE_URL=http://ollama:11434 (nome del servizio, risolto dalla rete
# interna di Compose). Vedi il README per i dettagli.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
