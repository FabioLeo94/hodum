{
  "entryFile": "src/app.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/controllers/**/*Controller.ts"],
  "spec": {
    "outputDirectory": "build",
    "specVersion": 3,
    "name": "Hodum API",
    "description": "API backend di Hodum",
    "version": "1.0.0",
    "securityDefinitions": {
      "jwt": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Token di sessione: 'Bearer <token>' ottenuto da POST /auth/login"
      }
    }
  },
  "routes": {
    "routesDir": "src/routes",
    "authenticationModule": "src/middleware/authentication.ts"
  }
}
