{
  "name": "hodum-backend",
  "description": "Hodum backend",
  "authors": "fabio leo",
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "main": "dist/server.js",
  "private": "true",
  "scripts": {
    "tsoa:gen": "tsoa spec-and-routes",
    "dev": "npm run tsoa:gen && tsx watch src/server.ts",
    "build": "npm run tsoa:gen && tsc -b",
    "start": "node dist/server.js",
    "migrate:up": "tsx src/db/migrate.ts",
    "migrate:create": "tsx src/db/createMigration.ts",
    "db:check": "tsx src/db/check.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.10.16",
    "@tsoa/runtime": "6.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "tsoa": "6.6.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
