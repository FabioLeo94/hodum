# Copia questo file in `.env` (mai committato, vedi .gitignore) e imposta i
# valori reali del tuo ambiente.

# Connessione PostgreSQL, formato: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Porta su cui ascolta il server Express (opzionale, default 3000 in src/server.ts).
PORT=3000

# Origine consentita per CORS, tipicamente il dev server Vite del frontend
# (opzionale, default http://localhost:5173 in src/app.ts).
FRONTEND_ORIGIN=http://localhost:5173

# URL del server Ollama locale (opzionale, default http://localhost:11434 in
# src/services/ollamaClient.ts).
OLLAMA_BASE_URL=http://localhost:11434

# Modello Ollama usato dall'assistente (opzionale, default qwen2.5:7b in
# src/services/assistantService.ts — scelto dopo test empirici: a parità di
# prompt e strumenti, il 14b dichiarava azioni riuscite senza aver mai chiamato
# il tool corrispondente, il 7b no). Deve essere già scaricato con `ollama pull`.
OLLAMA_MODEL=qwen2.5:7b

# Segreto usato per firmare i token di sessione (JWT) emessi da POST /auth/login
# (src/services/tokenService.ts). Obbligatoria: genera una stringa casuale lunga,
# es. con `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
JWT_SECRET=

# "production" in deploy, altrimenti lascia vuoto/non impostata in sviluppo
# locale. L'error handler globale (src/app.ts) la usa per decidere se un
# errore 500 può mostrare il messaggio interno (utile in dev) o deve restituire
# solo "Errore interno" (obbligatorio in produzione, altrimenti rischia di
# esporre dettagli implementativi al client).
NODE_ENV=

# Percorso dell'eseguibile pg_dump usato dalla feature di backup
# (src/services/backupService.ts). Opzionale: di default il processo cerca
# "pg_dump" nel PATH di sistema. Su Windows l'installer di PostgreSQL non
# aggiunge sempre la cartella bin al PATH, quindi se "spawn pg_dump ENOENT"
# compare eseguendo un backup, valorizzala con il percorso assoluto
# dell'eseguibile della STESSA versione major del server (es.
# "C:\Program Files\PostgreSQL\18\bin\pg_dump.exe" su Windows, o
# "/usr/lib/postgresql/18/bin/pg_dump" su Linux) invece di modificare il PATH
# di sistema.
PG_DUMP_PATH=pg_dump

# Percorso dell'eseguibile pg_restore usato dal ripristino di un backup
# ("Applica" nel drawer Backup, src/services/backupService.ts). Stessa
# avvertenza di PG_DUMP_PATH sopra: su Windows valorizzala con il percorso
# assoluto della STESSA versione major del server se "spawn pg_restore
# ENOENT" compare ripristinando un backup.
PG_RESTORE_PATH=pg_restore
