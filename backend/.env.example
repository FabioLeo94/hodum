# Copia questo file in `.env` (mai committato, vedi .gitignore) e imposta i
# valori reali del tuo ambiente.

# Connessione PostgreSQL, formato: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Porta su cui ascolta il server Express (opzionale, default 3000 in src/server.ts).
PORT=3000
