# Copia questo file in `.env` (mai committato, vedi .gitignore) e imposta i
# valori reali del tuo ambiente.

# Connessione PostgreSQL, formato: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Porta su cui ascolta il server Express (opzionale, default 3000 in src/server.ts).
PORT=3000

# Origine consentita per CORS, tipicamente il dev server Vite del frontend
# (opzionale, default http://localhost:5173 in src/app.ts).
FRONTEND_ORIGIN=http://localhost:5173

# URL del server Ollama locale (opzionale, default http://localhost:11434 in
# src/services/ollamaClient.ts).
OLLAMA_BASE_URL=http://localhost:11434

# Modello Ollama usato dall'assistente (opzionale, default qwen2.5:14b in
# src/services/assistantService.ts). Deve essere già scaricato con `ollama pull`.
OLLAMA_MODEL=qwen2.5:14b

# Segreto usato per firmare i token di sessione (JWT) emessi da POST /auth/login
# (src/services/tokenService.ts). Obbligatoria: genera una stringa casuale lunga,
# es. con `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
JWT_SECRET=

# "production" in deploy, altrimenti lascia vuoto/non impostata in sviluppo
# locale. L'error handler globale (src/app.ts) la usa per decidere se un
# errore 500 può mostrare il messaggio interno (utile in dev) o deve restituire
# solo "Errore interno" (obbligatorio in produzione, altrimenti rischia di
# esporre dettagli implementativi al client).
NODE_ENV=
